{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dialogue Situational Fingerprint",
  "type": "object",
  "required": ["schema_version","character_id","relationship_context","pressure_band","goal","directness","turn_shape_range","uncertainty_notes"],
  "properties": {
    "schema_version":{"type":"string"},"character_id":{"type":"string"},"relationship_context":{"type":"string"},
    "pressure_band":{"enum":["low","medium","high","extreme"]},"public_private":{"enum":["public","private","mixed","unknown"]},
    "body_state":{"type":"array","items":{"type":"string"}},"goal":{"type":"string"},"directness":{"enum":["low","medium","high","variable"]},
    "turn_shape_range":{"type":"array","items":{"enum":["short","medium","extended","mixed","silence"]}},
    "question_tendency":{"type":"string"},"avoidance_topics":{"type":"array","items":{"type":"string"}},
    "address_terms":{"type":"array","items":{"type":"string"}},"interruption_style":{"type":"string"},"silence_behavior":{"type":"string"},
    "lexical_register":{"type":"array","items":{"type":"string"}},"evidence_refs":{"type":"array","items":{"type":"string"}},
    "uncertainty_notes":{"type":"array","items":{"type":"string"}}
  }
}
